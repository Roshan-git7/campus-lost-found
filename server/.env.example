# Server Environment Variables
PORT=5000
NODE_ENV=development

# MongoDB Atlas Connection URI
# Format: mongodb+srv://<username>:<password>@cluster0.mongodb.net/campus_lost_found?retryWrites=true&w=majority
MONGO_URI=mongodb+srv://campus_user:your_password@cluster0.abcde.mongodb.net/campus_lost_found?retryWrites=true&w=majority

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_replace_in_production_2026
JWT_EXPIRES_IN=7d

# Cloudinary Image Storage (Optional for local disk fallback)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Allowed Client Origin (Frontend URL)
CLIENT_URL=http://localhost:5173

